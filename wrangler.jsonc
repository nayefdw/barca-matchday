{
  "name": "barca-matchday",
  "main": "worker/entry.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/calendar/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "FIXTURES",
      "id": "2cc6993893f1442b9f3a6f7c4d358afe"
    }
  ],
  "durable_objects": {"bindings": [{"name": "MATCH_SCHEDULER", "class_name": "MatchScheduler"}]},
  "migrations": [{"tag": "match-time-v1", "new_sqlite_classes": ["MatchScheduler"]}],
  "triggers": {"crons": []},
  "vars": {
    "TEAM_ID": "81",
    "SITE_ORIGIN": "https://barca-matchday.nayefdw.workers.dev",
    "VAPID_PUBLIC_KEY": "BMiuHGVASphcRwixO4h2d5x4MFmPEZ7-zohK0Uc1qkAIvBwN3AXVKihtwOkRPTkKKx1n6I0qX5W-kP8tH5q5aPs"
  },
  "account_id": "11a499c609102686547bafe2f71a51c1",
  "workers_dev": true
}
